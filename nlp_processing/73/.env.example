# make setup（無ければ cp .env.example .env）して値を埋める（.env は git 管理外）。make 経由の実行時に読み込まれる。
# 値はクォートで囲まない（make の include で読むため、クォートも値に含まれてしまう）。
# 使わないサービスの行は空のままでよい。

# Azure AI Content Safety（make setup-azure の出力を追記してもよい）
AZURE_CONTENT_SAFETY_NAME=
AZURE_RESOURCE_GROUP=rg-guardrail-test
AZURE_LOCATION=japaneast
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_SEVERITY_THRESHOLD=2

# Google Cloud Model Armor（認証は gcloud auth login）
GOOGLE_CLOUD_PROJECT=
MODEL_ARMOR_LOCATION=asia-northeast1
MODEL_ARMOR_TEMPLATE=guard-ja

# AWS Bedrock Guardrails（認証は aws sso login など）
# AWS_PROFILE=<プロファイル名>   # 空のまま有効にすると既定プロファイルを上書きするので、使うときだけ外す
AWS_REGION=ap-northeast-1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# OpenAI Moderation
OPENAI_API_KEY=
